%===============================================================
% Plot individual LADCP section using only EEL nominal stations
%-------
% TODO: In the case some cruise have more stations along the EEL:
% Create a similar function but using all LADCP stations available 
% along the EEL (use field ".onEELsection"). Only make plot for cruises
% with more stations that the nominal EEL
%
% TODO2: Plot mean section from mean profile and keep only apparent good data
% Dont take cruises where the LADCP data appear to be outliers compare to the other cruises
% (e.g. d32107, particularly from stations D to IB2)
%       d25301, LADCP data stopped before reaching the bottom)%% load data

clear all
close all

%load toolboxes
addpath(genpath('C:\Users\sa07kb\Matlab\toolboxes\gsw_matlab_v3_06_16'))
addpath(genpath('C:\Users\sa07kb\Matlab\toolboxes\cbrewer'))

% in path for data
global_path = 'C:\Users\sa07kb\OneDrive - SAMS\data\';
local_path = 'C:\Users\sa07kb\Projects\Rockall_Trough_Transports\';

% output path for figures
pathfig = [local_path,'figures\KB01_RT_transport_ship_sections_lh2020'];
figname = 'ladcp_mean_Rockall_Trough';

%% Parameter preamble 

% load RT parameters
rtp = loadParametersStruct('RT_parameters.m');

% Figures parameters
font_type = 'Calibri';
fs = 14;
set(0,'DefaultAxesFontName', font_type)
set(0,'DefaultAxesFontSize', fs)
set(0,'DefaultTextFontname', font_type)
set(0,'DefaultTextFontSize', fs)	
vsblfig = 'on';

pic_width = 17;
pic_height = 10;

collines = lines(7);
bathycolor = [1 1 1]*0.75;

%% load data 
% EEL ship sections
inpath = fullfile([global_path,'data_RT_EEL_cruises\ladcp_section\datamat_proc\']);
files = 'mean_LADCP_data_forRTpaper.mat';
fullFileName = fullfile(inpath, files);
load(fullFileName);

% load mean field from ctd to plot countour of density
ctd_fn='/data_RT_EEL_cruises/ctd_sections/scripts/proc/EEL_ctddata_withgvelanddepthiso.mat';
pathmeanctd = fullfile(global_path,ctd_fn);
ctd = load(pathmeanctd);

% Load mooring locations
local_data_path = 'C:\Users\sa07kb\Projects\Rockall_Trough_Transports\data\';
RT_file = fullfile(local_data_path, 'raw', 'Ellet_array_mooring_location.csv');
mooringTable = readtable(RT_file); % Store it in a variable
RT_loc = get_all_mooring_coords(mooringTable);

% load bathymetry
GEBCO_data_path = fullfile([global_path,'data_GEBCO\']);
GEBCO_fn = 'GEBCO_2014_2D_-22.0_55.0_-7.0_59.0.nc'; % Replace with your actual filename
full_file_path = fullfile(GEBCO_data_path, GEBCO_fn);
ds_GEBCO = load_gebco_data(full_file_path);

% load EEL ship sections
inpath = fullfile([global_path,'data_RT_EEL_cruises\ladcp_section\datamat_proc\']);
files = 'mean_LADCP_data_forRTpaper.mat';
fullFileName = fullfile(inpath, files);
ladcp_in = load(fullFileName);

%% Process the data for the 'RT' area using the new function
ladcp = process_loaded_ladcp_data(ladcp_in, 'RT');

%% plot all data

for i=1:17
    figure(1)
    subplot(5,4,i)
    contourf(ladcp.lon(:),ladcp.depth(:),squeeze(ladcp.v(:,:,i))')
    shading flat
    xline(ladcp.lon, ':', 'Color', [0.5 0.5 0.5], 'LineWidth', 0.5);
    for i=1:length(ladcp.lon);
        text(ladcp.lon(i), 2000, ladcp.cast_name(i), ...
         'HorizontalAlignment', 'center', ... % Centers text over the X coordinate
         'Rotation', 90, ...                  % Rotates text vertically (optional, helpful if names are long)
         'FontSize', 8);
    end
    axis ij
    hold on
end

%%  plot all stations
for i=1:17
    figure(2)
    subplot(5,4,18-i)
    slice_data = squeeze(ladcp.v(i, :, :));
    has_data_flag = any(~isnan(slice_data), 1);
    num_profiles_with_data = sum(has_data_flag);


    plot(slice_data,ladcp.depth)

    title_str = sprintf('%s, %d m, %d profiles', ladcp.cast_name(i), ...
        ladcp.cast_max_depth(i),num_profiles_with_data);
    title(title_str)
    ylim([0,2300])
    axis ij
end

%% area Rockal Trough

%% create grid

lon_WW = linspace(RT_loc.RTWS.lon,RT_loc.RTWB.lon,rtp.NX_WW);
lat_WW = linspace(RT_loc.RTWS.lat,RT_loc.RTWB.lat,rtp.NX_WW);
lon_MB = linspace(RT_loc.RTWB.lon,RT_loc.RTEB1.lon,rtp.NX_MB);
lat_MB = linspace(RT_loc.RTWB.lat,RT_loc.RTEB1.lat,rtp.NX_MB);
lon_EW = linspace(RT_loc.RTEB1.lon,RT_loc.RTES.lon,rtp.NX_MB);
lat_EW = linspace(RT_loc.RTEB1.lat,RT_loc.RTES.lat,rtp.NX_MB);

%% bathymetry
% Check and transpose elevation if necessary so Z(lat, lon) or Z(rows, columns)
[Lon_grid, Lat_grid] = meshgrid(ds_GEBCO.lon, ds_GEBCO.lat);
Z_elevation = ds_GEBCO.elevation'; % Transpose based on your dimensions

% --- 3. Perform the Interpolation ---

% Use interp2 to estimate the elevation at your specific MB coordinates
% Method 'linear' is standard, 'cubic' is smoother but slower.
bathy_MB = interp2(Lon_grid, Lat_grid, Z_elevation, lon_MB, lat_MB, 'linear');

% --- 4. Optional: Plot the results ---
figure;
plot(lon_MB, bathy_MB, '-x');

yline(-1760, '--r', '1760 m threshold');
xlabel('Longitude');
ylabel('Depth (m)');
title('Bathymetry along Measurement Section');
grid on;

%% --- 5. Calculate the area of the Rockall Trough ---
% Define the depth threshold (in meters)
depth_threshold = -1760;

% two areas (east and west of seamount
lon_divid = -11;
idx_w = find(lon_MB<-11);
idx_e = find(lon_MB>=-11);

% 2. Call the function
area_e = calculate_deep_area(lat_MB(idx_e), lon_MB(idx_e), ...
                            bathy_MB(idx_e), depth_threshold);
area_w = calculate_deep_area(lat_MB(idx_w), lon_MB(idx_w), ...
                            bathy_MB(idx_w), depth_threshold);

disp(['Total returned area in main script: ', num2str((area_e+area_w)*1e-6), ' km^2']);
disp(['A current of 5mm translates to an error of ', num2str((area_e+area_w)*0.005*1e-6), ' Sv']);


%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% PLOT Mean Section Meridional velocity
original_indices = 1:length(ladcp.lon(:));
target_points = 100; 
finer_indices = linspace(1, length(ladcp.lon(:)), target_points);
lon_finer = interp1(original_indices, ladcp.lon(:), finer_indices, 'linear');
lat_finer = interp1(original_indices, ladcp.lat(:), finer_indices, 'linear');

bathy_hr = interp2(Lon_grid, Lat_grid, Z_elevation, lon_finer, lat_finer, 'linear');

contourvel = -15:2.5:15;
cvellim = [min(contourvel) max(contourvel)];
cmap=cbrewer('div','RdYlBu',length(contourvel));
cmap(floor(length(contourvel)/2),:)=[];
cmap=cmap(end:-1:1,:);

fig=figure('visible',vsblfig);
set(fig, 'PaperPositionMode', 'manual', 'PaperUnits', 'centimeters', ...
    'PaperPosition', [0 0 pic_width pic_height], 'PaperSize', [pic_width pic_height]);
% Set the overall font settings for THIS figure's axes immediately after creation
ax = gca;
ax.FontSize = fs;
ax.FontName = font_type;
    
contourf(ladcp.lon(:),-ladcp.depth(:),100*ladcp.mean_vct,contourvel,'linestyle','none')

caxis(cvellim); colormap(cmap); cb=colorbar;
hold on

[C,h] = contour(ctd.EELsta.reflon(1:50),-ctd.EELsta.pref,ctd.meanEELsta.sigma0.mean(:,1:50),27.2:0.1:27.9,'-+k');
clabel(C,h)
    
% Use the simple ylabel function now; the font properties are inherited from 'ax'
ylabel('Depth (m)') 

% When setting specific labels like YtickLabel, you can set the data without
% overriding the font properties if you set them globally on the axes already.
set(gca,'Ytick',-2000:500:0)

% We define the labels, the font settings from 'ax' are maintained.
set(gca,'YtickLabel',{'2000','1500','1000','500','0'})

lon_str = [-13:-9];
set(gca,'Xtick',lon_str)
new_labels = arrayfun(@(x) sprintf('%.0f°W', x), abs(lon_str), 'UniformOutput', false);
ax.XTickLabel = new_labels; 

% Colorbar label and ticks inherit the font properties from 'ax' automatically
cb.Label.String='Meridional velocity (cm s^{-1})';
cb.Ticks=[-15:5:15];
% cb_pos = cb.Position + [0.0 0 0 0]; %move it to the left
% cb.Position = cb_pos;
cb.Label.FontSize = fs;
cb.Label.FontName = font_type;

set(gca,'ylim',[-2500 0])
set(gca,'xlim',[min(RT_loc.RTWS.lon-.02) max(ladcp.lon)])

% Adding bathymetry area
area( lon_finer,bathy_hr,-3000,'Facecolor',[0.5 0.5 0.5])

% For text annotations, use the specific 'Fontsize' and 'Fontname' properties 
% to ensure consistency, as text objects do not always fully inherit from the axes parent.
xline(ladcp.lon, '--','color',[.5 .5 .5],  'LineWidth', 0.8); 
% text(ladcp.lon,repmat(-2000,length(ladcp.cast_name),1),ladcp.cast_name,...
%     'Fontsize',fs,'Fontname',font_type,'HorizontalAlignment','center')

% horizontal lines
plot([RT_loc.RTWB.lon RT_loc.RTEB1.lon],[-1760 -1760], ':k', ...
    'LineWidth',2);
plot([RT_loc.RTEB1.lon RT_loc.RTADCP.lon],[-1000 -1000], ':k', ...
    'LineWidth',2);

%vertical lines
y1=100;
h_line = plot([RT_loc.RTEB1.lon RT_loc.RTEB1.lon],[-1760 y1+100], ':k', ...
    'LineWidth',2);
h_line.Clipping = 'off';
plot([RT_loc.RTWB1.lon RT_loc.RTWB1.lon],[-1550 -50], ':k', ...
    'LineWidth',2);
h_line = plot([RT_loc.RTWB.lon RT_loc.RTWB.lon],[-1760 y1+100], ':k', ...
    'LineWidth',2);
h_line.Clipping = 'off';
plot([RT_loc.RTWB2.lon RT_loc.RTWB2.lon],[-1800 -1000], ':k', ...
    'LineWidth',2);
h_line = plot([RT_loc.RTES.lon RT_loc.RTES.lon],[-250 y1], ':k', ...
    'LineWidth',2);
h_line.Clipping = 'off';
h_line = plot([RT_loc.RTWS.lon RT_loc.RTWS.lon],[-250 y1], ':k', ...
    'LineWidth',2);
h_line.Clipping = 'off';
plot([RT_loc.RTADCP.lon RT_loc.RTADCP.lon],[-700 -50], ':k', ...
    'LineWidth',2);
plot ([RT_loc.RTEB1.lon RT_loc.RTWB1.lon RT_loc.RTWB2.lon], ...
     [-50 -50 -1000],'o', ...
     'MarkerEdgeColor', 'k', ...   % 'k' is the shortcut for black
     'MarkerFaceColor', 'g', ...   % 'g' is the shortcut for green
     'LineWidth', 1.5, ...         % Adjust border thickness as needed
     'MarkerSize', 10);
plot ([RT_loc.RTES.lon RT_loc.RTWS.lon], ...
     [-50 -50 ],'^', ...
     'MarkerEdgeColor', 'k', ...   % 'k' is the shortcut for black
     'MarkerFaceColor', 'r', ...   % 'g' is the shortcut for green
     'LineWidth', 1.5, ...         % Adjust border thickness as needed
     'MarkerSize', 10);
plot ([RT_loc.RTADCP.lon], ...
     [-50 ],'s', ...
     'MarkerEdgeColor', 'w', ...   % 'k' is the shortcut for black
     'MarkerFaceColor', 'b', ...   % 'g' is the shortcut for green
     'LineWidth', 1.5, ...         % Adjust border thickness as needed
     'MarkerSize', 10);

%
x1 = RT_loc.RTWB.lon;
x2= RT_loc.RTEB1.lon;
z = 100;
% h_line = plot([x1,x2], [z, z], ...
%     'k:', 'LineWidth', 2);
% h_line.Clipping = 'off';

text((x1+x2)/2, z, ... % Add slight vertical offset (+50m) to the text
     'Mid basin', ...
     'HorizontalAlignment', 'center', ... % Center the text above the midpoint
     'VerticalAlignment', 'bottom', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','k');

x1 = RT_loc.RTWS.lon;
x2= RT_loc.RTWB.lon;

text(x2-.05, z, ... % Add slight vertical offset (+50m) to the text
     'Western wedge', ...
     'HorizontalAlignment', 'right', ... % Center the text above the midpoint
     'VerticalAlignment', 'bottom', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','k');
% 
x1 = RT_loc.RTEB1.lon;
x2= RT_loc.RTES.lon;
text(x1+.05, z, ... % Add slight vertical offset (+50m) to the text
     'Eastern wedge', ...
     'HorizontalAlignment', 'left', ... % Center the text above the midpoint
     'VerticalAlignment', 'bottom', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','k');

h_text = text(RT_loc.RTEB1.lon, -1760, ... % Add slight vertical offset (+50m) to the text
     'EB1', ...
     'HorizontalAlignment', 'left', ... % Center the text above the midpoint
     'VerticalAlignment', 'top', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','w');
h_text.Rotation = 0;
h_text = text(RT_loc.RTWB.lon, -1710, ... % Add slight vertical offset (+50m) to the text
     'WB1/2', ...
     'HorizontalAlignment', 'right', ... % Center the text above the midpoint
     'VerticalAlignment', 'top', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','w');
h_text.Rotation = 0;
h_text = text(RT_loc.RTWB1.lon, -1500, ... % Add slight vertical offset (+50m) to the text
     'WB1', ...
     'HorizontalAlignment', 'right', ... % Center the text above the midpoint
     'VerticalAlignment', 'top', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','w');
h_text.Rotation = 0;
h_text = text(RT_loc.RTWB2.lon,-1810, ... % Add slight vertical offset (+50m) to the text
     'WB2', ...
     'HorizontalAlignment', 'center', ... % Center the text above the midpoint
     'VerticalAlignment', 'top', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','w');
h_text.Rotation = 0;
h_text = text(RT_loc.RTADCP.lon, -750, ... % Add slight vertical offset (+50m) to the text
     'RTADCP', ...
     'HorizontalAlignment', 'left', ... % Center the text above the midpoint
     'VerticalAlignment', 'bottom', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','w');
h_text.Rotation = -70;

 text(-13, -2450, ... % Add slight vertical offset (+50m) to the text
     '(b) Rockall Trough', ...
     'HorizontalAlignment', 'left', ... % Center the text above the midpoint
     'VerticalAlignment', 'bottom', ...  % Place text below the Y coordinate provided
     'FontName', font_type, ...          % Use your existing font variables
     'FontSize', fs, ...
     'color','w');

ax_pos = ax.Position - [-0.01 0 .05 0.1];
ax.Position = ax_pos;
ax.TickDir = 'out';
grid on

drawnow;
print(gcf,'-dpng','-r300',[pathfig filesep 'mean_vcur_' figname])

%% %%%%%
ladcp_gridded = regrid_ladcp_structure(ladcp)

%%
% Start with mid-basin transports
lon_w = RT_loc.RTWB.lon;
lon_e = RT_loc.RTEB1.lon;
z_lim = 1760;
year_idx = [1,7,8,13:17];

ladcp_MB = select_ladcp_lon_range(ladcp_gridded, ...
    lon_w, lon_e,z_lim,year_idx);
    
figure(7),cla
for i=1:length(year_idx);
    subplot(3,3,i)
    contourf(ladcp_MB.lon(:),ladcp_MB.depth(:),squeeze(ladcp_MB.v(:,:,i)))
    xline([lon_w lon_e], ':', 'Color', [0.5 0.5 0.5], 'LineWidth', 1);
    axis ij
end

ladcp_MB

%%
CT_pro = (ladcp_MB.CT(:,1,:)+ladcp_MB.CT(:,end,:))/2;
SA_pro = (ladcp_MB.SA(:,1,:)+ladcp_MB.SA(:,end,:))/2;
T_MB = calculateTransports(ladcp_MB, CT_pro, SA_pro, rtp)

filename = 'stats_midbasin.tex';
region = 'Mid-Basin (MB)';

generateStatsTable(T_MB, filename, region);

figure(10)
subplot(3,1,1),cla
plot(T_MB.Q)
subplot(3,1,2),cla
plot(T_MB.Qh)
hold on
plot(T_MB.Qh_pro)
legend('full','mean profile WB1/2, EB1')
subplot(3,1,3),cla
plot(T_MB.Qf)
hold on
plot(T_MB.Qf_pro)
legend('full','mean profile WB1/2, EB1')

%%
% Start with western wedge transports
lon_w = RT_loc.RTWS.lon;
lon_e = RT_loc.RTWB.lon;
z_lim = 1760;
year_idx = [1,4,7,8,11,13:17];

ladcp_WW = select_ladcp_lon_range(ladcp_gridded, ...
    lon_w, lon_e,z_lim,year_idx);
    
figure(8),cla
for i=1:length(year_idx);
    subplot(3,4,i)
    contourf(ladcp_WW.lon(:),ladcp_WW.depth(:),squeeze(ladcp_WW.v(:,:,i)))
    xline([lon_w lon_e], ':', 'Color', [0.5 0.5 0.5], 'LineWidth', 1);
    axis ij
end

ladcp_WW

CT_pro = ladcp_WW.CT(:,end,:);
SA_pro = ladcp_WW.SA(:,end,:);
T_WW = calculateTransports(ladcp_WW, CT_pro, SA_pro, rtp)

filename = 'stats_ww.tex';
region = 'Western Wedge';

generateStatsTable(T_WW, filename, region);

figure(11),cla
hold on
subplot(3,1,1),cla
plot(T_WW.Q)
subplot(3,1,2),cla
plot(T_WW.Qh)
hold on
plot(T_WW.Qh_pro)
legend('full WW','mean profile WB1/2')
subplot(3,1,3),cla
plot(T_WW.Qf)
plot(T_WW.Qf_pro)
legend('full WW','mean profile WB1/2')

%% Check tides EW
glider_path = 'C:\Users\sa07kb\OneDrive - SAMS\data\data_seaglider\2025_SE_Glider\';
filename = 'glider_sections_gridded_20251129.nc';
glider_file = [glider_path,filename];

lon = ncread(glider_file, 'lon');
lat = ncread(glider_file, 'lat');
time  = ncread(glider_file, 't');
t_n = length(time);
x_n = length(lon);
v_tide = NaN(x_n,t_n);

for i=1:x_n;
    v_tide(i,:) = tmd_tide_pred('Model_AO',time,lat(i),lon(i),'v');
end
who v_tide

%%
figure(3)
contourf(time,lon,v_tide)
